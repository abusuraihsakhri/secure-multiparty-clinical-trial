{
  "openapi": "3.1.0",
  "info": {
    "title": "Secure Multiparty Clinical Trial demonstration API",
    "version": "3.0.1-demo",
    "description": "Local rule-based demonstration only. Not a clinical service, an MPC protocol, or a privacy guarantee."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service liveness",
        "responses": {
          "200": {
            "description": "Running"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus text metrics",
        "responses": {
          "200": {
            "description": "Prometheus metrics",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "JSON metrics",
        "responses": {
          "200": {
            "description": "Counter snapshot"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate synthetic rule-based thresholds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration dossier"
          },
          "422": {
            "description": "Invalid input or identifier-pattern rejection"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock reply"
          },
          "422": {
            "description": "Identifier-pattern rejection"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory audit chain inspection",
        "responses": {
          "200": {
            "description": "In-memory hashes and chain-integrity check"
          }
        }
      }
    }
  }
}
